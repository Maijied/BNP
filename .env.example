# BNP Shop Environment Configuration Template
# Copy this file to .env.local and populate the secrets. Never commit .env.local!

# Confirm the actual canonical HTTPS origin before deployment. No domain is assumed.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_IS_SANDBOX=true

# cPanel MySQL Database Credentials (HostNF)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bnp_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=bnp_shop

# LoraHost Payment Bridge Credentials (PayStation Relay)
LORA_BRIDGE_URL=https://lorahost.lorapok.tech
LORA_BRIDGE_CLIENT_TOKEN=your_lorahost_bridge_client_token
LORA_RETURN_HMAC_TOKEN=your_lorahost_return_hmac_secret
LORA_WEBHOOK_HMAC_TOKEN=your_lorahost_webhook_hmac_secret

# Discord Notifications (Server-Side Only)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Pages admin authentication. Set actual secrets only through approved hosting
# secret storage. ADMIN_DEFAULT_* below are legacy seed-script settings and do
# not configure the Pages login or receipt-status throttle.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Legacy MySQL seed script only, not the Pages administrator.
ADMIN_DEFAULT_EMAIL=bikesnumberplate@gmail.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!


# BNP -> Lorapok Labs Courier API. All variables below are server-only.
# Keep disabled until payment settlement and sandbox acceptance are verified.
PATHAO_BACKEND_MODE=service
PATHAO_ENABLED=false
PATHAO_DISPATCH_ENABLED=false
PATHAO_STORE_MANAGEMENT_ENABLED=false
PATHAO_ENVIRONMENT=sandbox
# Stable non-secret identity, never taken from request headers/body.
PATHAO_MERCHANT_KEY=
PATHAO_PRODUCT_KEY=bnp
PATHAO_STORE_ID=
# Authenticated independent API origin or authorized COURIER_API_BINDING.
COURIER_API_URL=
COURIER_API_TOKEN=
COURIER_DISPATCH_SIGNING_KEY=
# Provider credentials do NOT belong in the storefront in service mode.
# Legacy embedded mode exists only for migration/tests and is never automatic.
# See services/pathao-api/.env.example for the independent service environment.

# Lorapok Labs parent catalog/order API. Default service mode never falls back to DB.
COMMERCE_BACKEND_MODE=service
PLATFORM_API_URL=
PLATFORM_MERCHANT_KEY=
PLATFORM_PRODUCT_KEY=bnp
PLATFORM_ENVIRONMENT=sandbox
# Separate least-privilege server keys; no broad token fallback.
PLATFORM_STOREFRONT_API_TOKEN=
PLATFORM_ADMIN_API_TOKEN=
# PLATFORM_API_BINDING may replace a URL in an authorized server deployment.
# When the courier module is mounted on the parent API origin:
COURIER_API_PATH_PREFIX=/courier

# Separate vintage sample-store adapter. No BNP scope/token fallback.
# Configure only for a deliberately registered application/environment.
VESPA_PLATFORM_API_URL=
VESPA_PLATFORM_STOREFRONT_API_TOKEN=
VESPA_PLATFORM_MERCHANT_KEY=
VESPA_PLATFORM_PRODUCT_KEY=
VESPA_PLATFORM_ENVIRONMENT=
# A server-side VESPA_PLATFORM_API_BINDING may replace the URL in supported hosting.
