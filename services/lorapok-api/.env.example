# Private server-only parent API settings. Payment gateway intentionally absent.
# PLATFORM_DB is its own D1 binding, not the legacy BNP DB or courier DB.
PLATFORM_ORDER_INTAKE_ENABLED=false
# Optional Node host: existing migrated independent DB, no automatic provisioning.
PLATFORM_DATABASE_PATH=
HOST=127.0.0.1
PORT=8790
# Optional courier module uses /courier/v1/* and separate least-privilege client keys.
# See ../pathao-api/.env.example for encrypted courier settings and COURIER_DB.
COURIER_DATABASE_PATH=
