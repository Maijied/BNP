// Example only. Not an active deployment configuration. Replace identifiers only
// after the account, worker, databases, routing and provisioning are approved.
{
  "name": "replace-with-approved-platform-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PLATFORM_ORDER_INTAKE_ENABLED": "false",
    "COURIER_ENABLED": "false",
    "COURIER_DISPATCH_ENABLED": "false",
    "COURIER_STORE_MANAGEMENT_ENABLED": "false",
    "COURIER_WEBHOOK_ENABLED": "false",
    "COURIER_RECONCILIATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "replace-with-approved-commerce-database",
      "database_id": "REPLACE_WITH_APPROVED_DATABASE_ID",
      "migrations_dir": "migrations"
    }
    // Optional courier storage is a DIFFERENT database/binding. When explicitly
    // approved, add COURIER_DB with migrations_dir: "../pathao-api/migrations".
    // Do not reuse the Pages/auth DB or PLATFORM_DB. No cron is enabled here.
  ]
}
