# Lorapok Labs Courier API, server-only environment. No real values in source control.
# COURIER_DB binding is independent of the BNP order database.
COURIER_ENCRYPTION_KEY=
COURIER_KEY_VERSION=
# Optional JSON mapping of old key versions to base64 32-byte decryption keys.
COURIER_OLD_KEYS_JSON=
COURIER_ENABLED=false
COURIER_DISPATCH_ENABLED=false
COURIER_STORE_MANAGEMENT_ENABLED=false
COURIER_WEBHOOK_ENABLED=false
COURIER_RECONCILIATION_ENABLED=false
# Optional Node 22 host. Existing migrated database, loopback unless deliberately changed.
COURIER_DATABASE_PATH=
HOST=127.0.0.1
PORT=8788
